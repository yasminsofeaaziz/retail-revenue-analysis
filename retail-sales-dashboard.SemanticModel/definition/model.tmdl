model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-MY
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Transform File from Sales File'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Transform File from Sales File\Helper Queries'

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Sales Prep","Sample File","Parameter1","Transform Sample File","Transform File","Country","Products","Location","Sales"]

annotation PBI_ProTooling = ["DevMode"]

ref table Country
ref table Products
ref table Location
ref table Sales
ref table Dates

