table Sales
	lineageTag: 93112784-6288-4d46-89ae-0c1ee514106a

	measure 'Total Revenue' = SUM(Sales[Amount])
		formatString: "RM"#,0.00;-"RM"#,0.00;"RM"#,0.00
		lineageTag: d6cbc28e-6d36-40a0-b2a5-f5c669e1e4cf

		annotation PBI_FormatHint = {"currencyCulture":"ms-MY"}

	measure 'Number of Orders' = COUNTROWS(Sales)
		formatString: #,0
		lineageTag: ffc07c69-cf4a-4ae2-bc22-b363c2172c27

	measure 'Total Rev Weekend' = CALCULATE([Total Revenue],Dates[isWeekend]="Yes")
		formatString: "RM"#,0.00;-"RM"#,0.00;"RM"#,0.00
		lineageTag: 7c7734a0-e733-47cd-902c-60fa60876aa6

		annotation PBI_FormatHint = {"currencyCulture":"ms-MY"}

	measure 'Total Rev Weekday' = CALCULATE([Total Revenue],Dates[isWeekend]="No")
		formatString: "RM"#,0.00;-"RM"#,0.00;"RM"#,0.00
		lineageTag: 33f122a1-728f-4ca4-a546-0bfdb87c5c58

		annotation PBI_FormatHint = {"currencyCulture":"ms-MY"}

	measure 'Total Rev PY' = CALCULATE([Total Revenue],SAMEPERIODLASTYEAR(Dates[Date]))
		formatString: "RM"#,0.00;-"RM"#,0.00;"RM"#,0.00
		lineageTag: 016ca274-0d72-4983-a300-87577445fd1b

		annotation PBI_FormatHint = {"currencyCulture":"ms-MY"}

	measure 'Total Rev Differences' = [Total Revenue]-[Total Rev PY]
		formatString: "RM"#,0.00;-"RM"#,0.00;"RM"#,0.00
		lineageTag: a36360bc-9c52-4793-8fee-4bd8ca3f326d

		annotation PBI_FormatHint = {"currencyCulture":"ms-MY"}

	measure '% Difference of Rev' = DIVIDE([Total Rev Differences],[Total Rev PY],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1bedab2d-9e53-461e-8890-c1e363ce6a12

